@page "/"
@inject BlazorControlCenter.Services.ServerStateService StateService
@implements IDisposable
@rendermode InteractiveServer
@using BlazorControlCenter.Services
@using ApexCharts
@using Syncfusion.Blazor.Buttons
@using MudBlazor

<PageTitle>Arduino Dashboard</PageTitle>

<div class="container-fluid vh-100">
    <header class="py-2">
        <h1>Arduino TCP Dashboard</h1>
    </header>

    <!-- Column layout not needed anymore; just let this column scroll -->
    <main class="d-flex flex-column h-100">
        <h3 class="mb-3">Connected Clients</h3>

        <!-- Scrollable area for everything below the header -->
        <div class="flex-grow-1 overflow-auto">
            @if (StateService.Clients.Any())
            {
                <div class="list-group">
                    @foreach (var client in StateService.Clients.Values.OrderBy(c => c.Id))
                    {
                        <!-- Row with client name + command input + send button -->
                        <div class="list-group-item">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold flex-grow-1">@client.Name</span>

                                <MudToggleIconButton @bind-Toggled="AlarmOn"
                                    Icon="@Icons.Material.Filled.AlarmOff"
                                    Color="@MudBlazor.Color.Error"
                                    ToggledIcon="@Icons.Material.Filled.AlarmOn"
                                    ToggledColor="@MudBlazor.Color.Success"
                                    title="@(AlarmOn ? "On" : "Off")" />

                                <span>Alarm is @(AlarmOn ? "On" : "Off")</span>
                                    

                                <input class="form-control form-control-sm"
                                       style="max-width: 220px"
                                       placeholder="Type command…"
                                       value="@GetCommand(client.Id)"
                                       @oninput="(e) => SetCommand(client.Id, e?.Value?.ToString() ?? string.Empty)" />

                                <button class="btn btn-primary btn-sm"
                                        @onclick="() => SendToClientAsync(client.Id)"
                                        title="Send to this client">
                                    Send
                                </button>
                            </div>
                        </div>

                        <!-- Charts live OUTSIDE the list item so they can expand to their heights -->
                        <div class="mb-4 px-3">
                            <ClientDataChart ClientId="@client.Id"
                                             OnRegistered="RegisterChartRef"
                                             Options="options"
                                             Title="@client.Name" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="list-group">
                    <div class="list-group-item">No clients connected.</div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private readonly Dictionary<int, ClientDataChart> clientChartRef = new();
    private readonly Dictionary<int, string> commandByClient = new();
    private ApexChartOptions<Scd4xDataPoint> options = new();

    public bool AlarmOn { get; set; }


    void ClickMe() => Console.WriteLine("Button clicked!");

    protected override void OnInitialized()
    {
        options.PlotOptions = new PlotOptions
            {
                Line = new PlotOptionsLine { /* customize colors/styles if needed */ }
            };

        StateService.OnScd4xDataReady += UpdateChartData;
        StateService.OnChange += OnClientsChanged;
    }

    private void OnClientsChanged()
    {
        var connectedIds = StateService.Clients.Keys.ToHashSet();

        // remove stale chart refs
        foreach (var key in clientChartRef.Keys.Where(k => !connectedIds.Contains(k)).ToList())
            clientChartRef.Remove(key);

        // remove stale command inputs
        foreach (var key in commandByClient.Keys.Where(k => !connectedIds.Contains(k)).ToList())
            commandByClient.Remove(key);

        InvokeAsync(StateHasChanged);
    }

    // child chart calls this during first render
    private async Task RegisterChartRef((int id, ClientDataChart self) reg)
    {
        clientChartRef[reg.id] = reg.self;
        return;
        // await reg.self.AddDataPointAsync(new Scd4xDataPoint(800m, 40f, 40f, reg.id));
    }

    // dispatcher-safe update to chart
    private void UpdateChartData(Scd4xDataPoint dataPoint)
    {
        _ = InvokeAsync(async () =>
        {
            if (clientChartRef.TryGetValue(dataPoint.clientId, out var chart) && chart is not null)
            {
                await chart.AddDataPointAsync(dataPoint);
            }
        });
    }

    private string GetCommand(int clientId) =>
        commandByClient.TryGetValue(clientId, out var s) ? s : string.Empty;

    private void SetCommand(int clientId, string value) =>
        commandByClient[clientId] = value;

    private async Task SendToClientAsync(int clientId)
    {
        if (!commandByClient.TryGetValue(clientId, out var cmd) || string.IsNullOrWhiteSpace(cmd))
            return;

        var ok = await StateService.SendCommandAsync(clientId, cmd.Trim());
        if (ok)
        {
            commandByClient[clientId] = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        StateService.OnScd4xDataReady -= UpdateChartData;
        StateService.OnChange -= OnClientsChanged;
    }
}
