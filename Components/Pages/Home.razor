@page "/"
@inject BlazorControlCenter.Services.ServerStateService StateService
@implements IDisposable
@rendermode InteractiveServer
@using BlazorControlCenter.Services
@using ApexCharts
@using Syncfusion.Blazor.Buttons
@using MudBlazor
@using MudBlazor.FontIcons.MaterialSymbols


<PageTitle>Arduino Dashboard</PageTitle>

<div class="container-fluid vh-100">
    <header class="py-2">
        <h1>Arduino TCP Dashboard</h1>
    </header>

    <main class="d-flex flex-column h-100">
        <h3 class="mb-3">Connected Clients</h3>

        <div class="flex-grow-1 overflow-auto">
            @if (StateService.Clients.Any())
            {
                <div class="list-group">
                    @foreach (var client in StateService.Clients.Values.OrderBy(c => c.Id))
                    {
                        var currentClient = client;

                        <div class="list-group-item">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold flex-grow-1">@currentClient.Name</span>

                                <MudToggleIconButton Toggled="@currentClient.humState"
                                                     ToggledChanged="(newState) => OnHumidToggleChanged(currentClient.Id, newState)"
                                                     Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.HumidityLow"
                                                     Color="@MudBlazor.Color.Error"
                                                     ToggledIcon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.HumidityHigh"
                                                     ToggledColor="@MudBlazor.Color.Success"
                                                     title="@(currentClient.humState ? "Turn Off" : "Turn On")" />

                                <span>Humidifier is @(currentClient.humState ? "On" : "Off")</span>

                                <MudToggleIconButton Toggled="@currentClient.fanState"
                                                     ToggledChanged="(newState) => OnFanToggleChanged(currentClient.Id, newState)"
                                                     Icon="@Icons.Material.Filled.ModeFanOff"
                                                     Color="@MudBlazor.Color.Error"
                                                     ToggledIcon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.ModeFan"
                                                     ToggledColor="@MudBlazor.Color.Success"
                                                     title="@(currentClient.fanState ? "Turn Off" : "Turn On")" />

                                <span>Fan is @(currentClient.fanState ? "On" : "Off")</span>

                                <input class="form-control form-control-sm"
                                       style="max-width: 220px"
                                       placeholder="Type command…"
                                       value="@GetCommand(currentClient.Id)"
                                       @oninput="(e) => SetCommand(currentClient.Id, e?.Value?.ToString() ?? string.Empty)" />

                                <button class="btn btn-primary btn-sm"
                                        @onclick="() => SendToClientAsync(currentClient.Id)"
                                        title="Send to this client">
                                    Send
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="list-group">
                    <div class="list-group-item">No clients connected.</div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private readonly Dictionary<int, string> commandByClient = new();

    protected override void OnInitialized()
    {
        StateService.OnChange += OnClientsChanged;
        StateService.RelayStateChanged += OnRelayChanged;
    }

    private void OnRelayChanged(int clientId, bool humidOn, bool fanOn)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnHumidToggleChanged(int id, bool newState)
    {
        string command = newState ? "HUM_ON" : "HUM_OFF";
        StateService.AddLogMessage($"UI toggle for client {id}: sending command '{command}'");
        SetCommand(id, command);
        await SendToClientAsync(id);
    }

    private async Task OnFanToggleChanged(int id, bool newState)
    {
        string command = newState ? "FAN_ON" : "FAN_OFF";
        StateService.AddLogMessage($"UI toggle for client {id}: sending command '{command}'");
        SetCommand(id, command);
        await SendToClientAsync(id);
    }

    private void OnClientsChanged()
    {
        var connectedIds = StateService.Clients.Keys.ToHashSet();
        //remove stale command inputs
        foreach (var key in commandByClient.Keys.Where(k => !connectedIds.Contains(k)).ToList())
        {
            commandByClient.Remove(key);
        }
        InvokeAsync(StateHasChanged);
    }

    private string GetCommand(int clientId) =>
        commandByClient.TryGetValue(clientId, out var s) ? s : string.Empty;

    private void SetCommand(int clientId, string value) =>
        commandByClient[clientId] = value;

    private async Task SendToClientAsync(int clientId)
    {
        if (!commandByClient.TryGetValue(clientId, out var cmd) || string.IsNullOrWhiteSpace(cmd))
        {
            StateService.AddLogMessage($"Failed to find command for the specified client: {clientId}");
            return;
        }

        var ok = await StateService.SendCommandAsync(clientId, cmd.Trim());
        if (ok)
        {
            commandByClient[clientId] = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        StateService.OnChange -= OnClientsChanged;
        StateService.RelayStateChanged -= OnRelayChanged;
    }
}